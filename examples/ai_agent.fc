## Agent.use_tool()
N1 start 開始 (self, name, args)
N2 end 終了
N3 proc tool = self.tools.get(name)
N4 if tool is None ?
N5 io return json.dumps({'error': f'未登録のツール: {name}'})
N6 if try
N7 proc with open('tool_log.txt', 'a') as log
N8 proc log.write(f'{name} {args}\n')
N9 io return json.dumps(tool(**args))
N10 proc except Exception
N11 io return json.dumps({'error': str(e)})
