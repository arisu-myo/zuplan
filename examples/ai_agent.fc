## Agent.run()
N1 start 開始 (self, question)
N2 end 終了
N3 proc context = self.retrieve(question)
N4 if not context ?
N5 io print('関連資料なし。一般知識で回答します')
N6 proc self.history.append({'role': 'user', 'content':…
N7 if for step in range(MAX_STEPS)
N8 proc self.trim_history()
N9 proc reply = self.call_llm()
N10 if reply is None ?
N11 io return '申し訳ありません。モデルに接続できませんでした'
N12 if reply['type'] == 'answer' ?
N13 proc self.history.append({'role': 'assistant', 'cont…
N14 io return reply['text']
N15 if reply['type'] == 'tool_call' ?
N16 proc result = self.use_tool(reply['name'], reply['ar…
N17 proc self.history.append({'role': 'tool', 'name': re…
N18 proc continue
N19 io print('不明な応答形式:', reply['type'])
N20 proc break
N21 io return 'ステップ上限に達したため、途中結果を返します'
